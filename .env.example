# Alpaca PAPER account credentials only.
APCA_API_KEY_ID=replace_with_paper_key
APCA_API_SECRET_KEY=replace_with_paper_secret
PAPER_TRADING=true
# Both an S&P 500 ETF and crypto. Use symbols supported by your paper account.
SYMBOLS=SPY,BTC/USD
QTY=1
CRYPTO_QTY=0.001
POLL_SECONDS=60
SHORT_WINDOW=5
LONG_WINDOW=20
