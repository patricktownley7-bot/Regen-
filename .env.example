# Alpaca PAPER account credentials only.
APCA_API_KEY_ID=replace_with_paper_key
APCA_API_SECRET_KEY=replace_with_paper_secret
PAPER_TRADING=true

# Comma-separated stock and crypto symbols.
ASSETS=SPY,BTC/USD
QTY=1
# Optional per-asset quantities. BTC/USD may be fractional.
QTY_BTC_USD=0.0001
POLL_SECONDS=60
SHORT_WINDOW=5
LONG_WINDOW=20
